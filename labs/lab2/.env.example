# Copy this file to .env and fill in the values
#   cp .env.example .env

# Optional — only required if you choose the HuggingFace Inference API
# path instead of local Ollama.
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local Ollama model name used across all labs/ files
OLLAMA_MODEL=qwen2.5:7b

# Set to 1 to use the HuggingFace Inference API instead of local Ollama
USE_HUGGINGFACE=0
