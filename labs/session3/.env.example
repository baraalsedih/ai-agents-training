# Copy this file to .env and change values as needed
#   cp .env.example .env
# All of these are optional — config.py falls back to the defaults shown
# here if a variable isn't set. Nothing below is a secret; this lab makes
# no external API calls, so there's no API key to configure.

# Chat model used for classification (ingest.py) and answer generation
# (ask.py). Pull it first: ollama pull llama3.1:8b
CHAT_MODEL=llama3.1:8b

# Embedding model — must stay identical for the entire life of a given
# knowledge base (see README.md). Changing it requires rebuilding from
# scratch. Pull it first: ollama pull bge-m3
EMBEDDING_MODEL=bge-m3

# Characters per chunk, and how many characters consecutive chunks share.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# How many chunks ask.py retrieves per question by default.
RETRIEVAL_K=8
